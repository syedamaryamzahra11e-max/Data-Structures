void swapNodes(Node* &head, Node* &last, int val1, int val2) {
    if (val1 == val2) return;

    Node* node1 = head;
    Node* node2 = head;

    // Find nodes
    while (node1 && node1->data != val1) node1 = node1->next;
    while (node2 && node2->data != val2) node2 = node2->next;

    if (!node1 || !node2) return; // Not found

    // Adjust head and last if needed
    if (node1 == head) head = node2;
    else if (node2 == head) head = node1;

    if (node1 == last) last = node2;
    else if (node2 == last) last = node1;

    // Swap prev links
    if (node1->prev) node1->prev->next = node2;
    if (node2->prev) node2->prev->next = node1;

    Node* temp = node1->prev;
    node1->prev = node2->prev;
    node2->prev = temp;

    // Swap next links
    if (node1->next) node1->next->prev = node2;
    if (node2->next) node2->next->prev = node1;

    temp = node1->next;
    node1->next = node2->next;
    node2->next = temp;
}
